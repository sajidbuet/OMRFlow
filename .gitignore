# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.eggs/

# Release artefacts staged for the clean-machine test. The .wsb and the
# scripts beside it are version-controlled; the installer copied in here is
# a build output and must not be.
packaging/sandbox/payload/
packaging/sandbox/results/
packaging/sandbox/*.generated.wsb

# Environments
.venv/
venv/
env/

# Tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/

# Editors / OS
.vscode/
.idea/
*.swp
Thumbs.db
desktop.ini
.DS_Store

# OMRFlow runtime artefacts
# Projects contain candidate data and scans; they are never committed, even if a
# developer creates one inside the working tree for convenience.
*.sqlite
*.sqlite-journal
*.log
/projects/
/scratch/

# Generated GUI test artefacts: screenshots, geometry dumps and failure
# diagnostics written by the `qtguitesting` skill's scripts. Regenerated on
# demand and never a committed baseline - see
# `.claude/skills/qtguitesting/SKILL.md`.
/test-output/

# Phase 3 evaluation artefacts.
#
# Generated synthetic datasets, benchmark reports, diagnostic dumps and
# calibration output are all reproducible from the generator plus its seed
# (`python -m omr_scanner.tools.make_dataset`), so the seed is worth committing
# and the gigabytes are not. What *is* committed: the generator itself, the
# manifests that record how a dataset was made, and the small result fixtures
# in `tests/fixtures/recognition/`.
/synthetic_dataset/
/datasets/
/benchmark_results/
/diagnostics/
/calibration/

# Real-world validation data. Scans of real answer sheets carry candidate
# identifiers and must never reach a public repository - see
# `local_test_data/README.md` for the expected layout. The README itself is
# committed; nothing inside the data folders is.
/local_test_data/**
!/local_test_data/README.md
/real_dataset/
/private_dataset/
/private_test_data/

# Candidate/attendance lists (Phase 7). A real roster is a list of names and
# roll numbers, so one left in the working tree must not be committed by
# accident. The committed fixtures under `tests/fixtures/reconciliation/` and
# the packaged sample inside the package are fictional and stay tracked.
/candidate_lists/
/*.xlsx
/*.csv
!/tests/fixtures/**/*.csv

# Benchmark reports written beside a dataset by Tools > Developer / Testing.
# Reproducible from the dataset plus the engine, and the interesting one is
# always the *latest*, which is not a thing to keep in version control.
benchmark_report/
